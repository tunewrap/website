{
  "name": "tunewrap-web",
  "private": true,
  "version": "11.0.0",
  "description": "TuneWrap mobile web application",
  "scripts": {
    "tracks:build": "node scripts/tracks-build.js",
    "tracks:check": "node scripts/tracks-build.js --check",
    "tracks:import": "node scripts/tracks-import.js",
    "tracks:test-artwork": "node scripts/tracks-artwork-test.js",
    "tracks:test-queue": "node scripts/tracks-queue-test.js",
    "tracks:test-scale": "node scripts/tracks-scale-test.js",
    "admin:seed-build": "node scripts/generate-d1-seed.js",
    "admin:migrate-local": "wrangler d1 migrations apply tunewrap-catalog --local",
    "admin:dev": "wrangler pages dev . --binding ENVIRONMENT=development",
    "admin:test": "node scripts/admin-catalog-test.js",
    "test": "npm run tracks:check && npm run tracks:test-queue && npm run tracks:test-artwork && npm run tracks:test-scale && npm run admin:test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "jose": "^6.2.8"
  }
}
